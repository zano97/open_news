# Copia in `.env` e personalizza. Tutti i default funzionano per lo sviluppo locale.

# Password del Postgres dello stack compose
POSTGRES_PASSWORD=opennews

# Chiave master di Meilisearch
MEILI_MASTER_KEY=opennews-dev-key-change-me

# Chiave per firmare i cookie di sessione (annotazione). Generane una: `openssl rand -hex 32`
SECRET_KEY=dev-secret-change-me

# Dominio pubblico per Caddy/HTTPS automatico (lascia vuoto in sviluppo)
# DOMAIN=notizie.esempio.org

# Backend embedding: "hashing" (nessun download, deterministico, qualità inferiore)
# oppure "e5" (sentence-transformers intfloat/multilingual-e5-base, richiede extra [ml])
EMBEDDING_BACKEND=hashing

# LLM locale opzionale (profilo compose `llm`): mai giudice del bias.
ENABLE_LLM=false
